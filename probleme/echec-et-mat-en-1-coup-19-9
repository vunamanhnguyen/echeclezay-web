<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Échec et mat en 1 coup</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      background: #000;
      color: #fff;
    }

    .puzzle {
      width: min(92vw, 520px);
      text-align: center;
    }

    .badge {
      display: inline-block;
      padding: 6px 12px;
      margin-bottom: 12px;
      border: 1px solid #4caf50;
      border-radius: 999px;
      color: #4caf50;
      font-size: 13px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(28px, 7vw, 42px);
    }

    .description {
      margin: 0 0 24px;
      color: #bbb;
      font-size: 16px;
    }

    .board {
      width: 100%;
      aspect-ratio: 1;
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      border: 4px solid #fff;
      box-shadow: 0 0 0 2px #222;
    }

    .square {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(28px, 8vw, 54px);
      cursor: pointer;
      user-select: none;
    }

    .light {
      background: #fff;
      color: #000;
    }

    .dark {
      background: #1f7a3a;
      color: #fff;
    }

    .square.selected {
      outline: 4px solid #fff;
      outline-offset: -4px;
    }

    .result {
      min-height: 30px;
      margin-top: 20px;
      font-size: 18px;
      font-weight: bold;
    }

    button {
      margin-top: 12px;
      padding: 10px 18px;
      border: 1px solid #4caf50;
      border-radius: 6px;
      background: transparent;
      color: #4caf50;
      font-size: 15px;
      cursor: pointer;
    }

    button:hover {
      background: #4caf50;
      color: #000;
    }
  </style>
</head>

<body>

  <main class="puzzle">
    <div class="badge">NIVEAU FACILE</div>

    <h1>Échec et mat en 1 coup</h1>

    <p class="description">
      Les Blancs jouent. Trouvez le coup qui met immédiatement le Roi noir échec et mat.
    </p>

    <div class="board" id="board"></div>

    <div class="result" id="result"></div>

    <button onclick="resetPuzzle()">Réinitialiser</button>
  </main>

  <script>
    /*
      Position :

      8  . . . . . . . .
      7  . . . . . . . .
      6  . . . . . . . .
      5  . . . . . . . .
      4  . . . . . . . .
      3  . . . . . . . .
      2  . . . . . . R .
      1  . . . . . . . K

         a b c d e f g h

      Les Blancs jouent : Rh2#
    */

    const position = {
      h1: "♔",
      g2: "♖",
      g8: "♚"
    };

    const solution = "g2-g8";

    let selected = null;

    const board = document.getElementById("board");
    const result = document.getElementById("result");

    function createBoard() {
      board.innerHTML = "";

      const files = ["a", "b", "c", "d", "e", "f", "g", "h"];

      for (let rank = 8; rank >= 1; rank--) {
        for (let fileIndex = 0; fileIndex < 8; fileIndex++) {

          const file = files[fileIndex];
          const squareName = file + rank;

          const square = document.createElement("div");

          const isDark =
            (fileIndex + rank) % 2 === 0;

          square.className =
            "square " + (isDark ? "dark" : "light");

          square.dataset.square = squareName;

          if (position[squareName]) {
            square.textContent = position[squareName];
          }

          square.addEventListener("click", () => play(squareName));

          board.appendChild(square);
        }
      }
    }

    function play(square) {

      if (!selected) {

        if (position[square] === "♖") {
          selected = square;

          document
            .querySelector(`[data-square="${square}"]`)
            .classList.add("selected");

          result.textContent = "Choisissez la case d'arrivée.";

        } else {
          result.textContent = "Cliquez sur la Tour blanche.";
        }

        return;
      }

      const move = selected + "-" + square;

      if (move === solution) {

        result.textContent = "♟ ÉCHEC ET MAT ! Bravo !";
        result.style.color = "#4caf50";

      } else {

        result.textContent = "Ce n'est pas le mat. Essayez encore !";
        result.style.color = "#fff";
      }

      selected = null;

      document
        .querySelectorAll(".selected")
        .forEach(el => el.classList.remove("selected"));
    }

    function resetPuzzle() {
      selected = null;
      result.textContent = "";
      result.style.color = "#fff";
      createBoard();
    }

    createBoard();
  </script>

</body>
</html>
